{
  "name": "docs-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/run-with-env.mjs mastra build",
    "dev": "MASTRA_STORAGE_URL=file:$PWD/mastra.db node ../../scripts/run-with-env.mjs mastra dev",
    "eval:seed": "MASTRA_STORAGE_URL=file:$PWD/mastra.db node ../../scripts/run-with-env.mjs tsx src/evals/seed.ts",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "start": "MASTRA_STORAGE_URL=file:$PWD/mastra.db node ../../scripts/run-with-env.mjs mastra start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/ai-sdk": "1.10.3",
    "@mastra/core": "1.67.0",
    "@mastra/evals": "1.10.2",
    "@mastra/libsql": "1.23.0",
    "@mastra/loggers": "1.3.2",
    "@mastra/mcp": "1.18.0",
    "@mastra/observability": "1.17.8",
    "ai": "7.0.107",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "mastra": "1.30.0",
    "tsx": "4.20.6",
    "typescript": "catalog:"
  }
}
